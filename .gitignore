#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git-ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.

# Placeholder files for directories needed to be inside git but empty
!.gitignore
!.gitattributes

# JetBrains - project settings
/.idea/

# Eclipse - project settings
/.project
/.settings
/.buildpath
/.externalToolBuilders

# Sublime Text 2 - project files
/*.sublime-build
/*.sublime-project
/*.sublime-workspace

# Visual Studio Code - project settings
.vscode

# Numerous always-ignore extensions
*.a
*.bak
*.bin
*.diff
*.err
*.gz
*.lo
*.log
*.o
*.o.*
*.orig
*.patch
*.rej
*.so
*.so.dbg
*.swo
*.swp
*.vi
*~
callgrind.out.*

# OS or Editor folders
.DS_Store
.cache
.project
.settings
.tmproj
nbproject
Thumbs.db

# Configuration files to be customized

# Build directories. Anchored at the root: an unanchored "build" also swallows
# dep/recastnavigation/RecastDemo/Build on case-insensitive filesystems.
/bin/
_build
/build/
/install/
/database/
/.client/

# Generated files
*.ncb
*.opensdf
*.sdf
*.sln.cache
*.suo
*.user
*.vsp
cmake_install.cmake
CMakeCache.txt
CMakeFiles
ipch
ANALIZA*.txt

# recastnavigation directory needs exception
!/dep/recastnavigation/RecastDemo/Build/

/src/tools/Extractor_Binaries/*.exe

# AI assistant scratch. Agent config belongs to the workspace, not to a core;
# docs/superpowers was a pure artifact (it ignored its own entire contents).
.claude/
docs/superpowers/

# Compiler caches. The Windows CI job deliberately puts CCACHE_DIR *inside* the
# checkout (.ccache/): actions/cache rejects a path containing '..' and saves
# nothing at all, silently. Ignoring it is therefore load-bearing, not a safety
# net -- without it the "working tree is clean" guard at the end of the job fails
# on the cache instead of on a real change. Local builds keep their caches
# wherever the developer points CCACHE_DIR/SCCACHE_DIR.
.ccache/
.sccache/
src/shared/revision_data.h

# Docker compose runtime state (extra/docker): configs, client data, logs, secrets
/extra/docker/etc/
/extra/docker/data/
/extra/docker/logs/
/extra/docker/.env

# The movement wire goldens are the one kind of capture the tree checks in.
!src/tests/goldens/movement/*.log
