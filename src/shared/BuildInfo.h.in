#pragma once

// GENERATED from BuildInfo.h.in by cmake/MangosVersion.cmake, which declares
// every value substituted below. A number written here directly is one that
// cannot be bumped from the place everything else is bumped.
//
// The commit hash is in here, so this header is rewritten by every commit and
// everything including it recompiles. Exactly one translation unit does --
// src/shared/Common/Version.cpp, the umbrella everything else reads through --
// and src/tests/CheckVersionSources.cmake keeps it that way.
//
// cmake/win/VersionInfo.rc includes it too. The resource compiler is not a C++
// compiler: nothing here may need a C++ header, and every macro it reads has to
// be one literal rather than adjacent literals a compiler would join.

// --- What this build is ------------------------------------------------------

#define MANGOS_PACKAGENAME "@MANGOS_PKG@"
#define MANGOS_VERSION_STR "@PROJECT_VERSION@"
#define MANGOS_RELEASE_STR MANGOS_PACKAGENAME " " MANGOS_VERSION_STR

// --- What it was built from --------------------------------------------------
//
// REVISION_STR is one literal because the version resource reads it too.

#define REVISION_HASH "@rev_hash@"
#define REVISION_DATE "@rev_date@"
#define REVISION_STR  "@rev_hash@ @rev_date@ (@rev_branch@ branch)"

#define BUILD_HOST_SYSTEM R"(@CMAKE_HOST_SYSTEM_NAME@ @CMAKE_HOST_SYSTEM_VERSION@)"

// --- Configuration files it expects ------------------------------------------
//
// Format YYYYMMDDRR. Compared against the ConfVersion in the .conf actually
// loaded; the same values are substituted into the .conf.dist templates, so the
// two sides cannot disagree.

#define MANGOSD_CONFIG_VERSION @MANGOS_WORLD_VER@
#define REALMD_CONFIG_VERSION  @MANGOS_REALM_VER@
#define AHBOT_CONFIG_VERSION   @MANGOS_AHBOT_VER@

// --- The client it speaks ----------------------------------------------------
//
// One build, deliberately: two would mean half the features work for one set of
// players and half for the other, with neither half testable. The trailing zero
// terminates the list Version.cpp walks.

#define EXPECTED_MANGOSD_CLIENT_BUILD   {@MANGOS_CLIENT_BUILD@, 0}
#define EXPECTED_MANGOSD_CLIENT_VERSION "@MANGOS_CLIENT_VERSION@"

// --- Database schemas it requires --------------------------------------------

#define REALMD_DB_VERSION_NR      "@MANGOS_REALMD_DB_VERSION@"
#define REALMD_DB_STRUCTURE_NR    "@MANGOS_REALMD_DB_STRUCTURE@"
#define REALMD_DB_CONTENT_NR      "@MANGOS_REALMD_DB_CONTENT@"
#define REALMD_DB_UPDATE_DESCRIPT "@MANGOS_REALMD_DB_DESCRIPT@"

#define CHAR_DB_VERSION_NR        "@MANGOS_CHAR_DB_VERSION@"
#define CHAR_DB_STRUCTURE_NR      "@MANGOS_CHAR_DB_STRUCTURE@"
#define CHAR_DB_CONTENT_NR        "@MANGOS_CHAR_DB_CONTENT@"
#define CHAR_DB_UPDATE_DESCRIPT   "@MANGOS_CHAR_DB_DESCRIPT@"

#define WORLD_DB_VERSION_NR       "@MANGOS_WORLD_DB_VERSION@"
#define WORLD_DB_STRUCTURE_NR     "@MANGOS_WORLD_DB_STRUCTURE@"
#define WORLD_DB_CONTENT_NR       "@MANGOS_WORLD_DB_CONTENT@"
#define WORLD_DB_UPDATE_DESCRIPT  "@MANGOS_WORLD_DB_DESCRIPT@"

// --- Where it installs itself ------------------------------------------------
//
// The file names themselves are not generated and live in Common/ServerDefines.h.

#define SYSCONFDIR "@CONF_RUNTIME_DIR@/"

#define MANGOSD_CONFIG_LOCATION         SYSCONFDIR "mangosd.conf"
#define REALMD_CONFIG_LOCATION          SYSCONFDIR "realmd.conf"
#define AUCTIONHOUSEBOT_CONFIG_LOCATION SYSCONFDIR "ahbot.conf"

// --- Windows version resource ------------------------------------------------
//
// cmake/win/VersionInfo.rc is the only consumer and the only .rc in the tree.
// Each executable compiles it with an icon and two strings of its own.

#define PRODUCT_VERSION_RESOURCE @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define PRODUCT_COMPANY_STR      "MaNGOS Developers"
#define PRODUCT_COPYRIGHT_STR    "Copyright (C) 2005-@rev_year@ MaNGOS"
