// The one version resource in the tree: mangosd, realmd, the extractor and its
// window all compile this file. Four definitions differ per target and arrive
// from each CMakeLists:
//
//   PRODUCT_ICON             path to the .ico for this executable
//   PRODUCT_FILE_NAME        "mangosd.exe", for InternalName/OriginalFilename
//   PRODUCT_FILE_DESCRIPTION what Explorer shows in the Description column
//   PRODUCT_LOGO             optional; raw bytes the GUI decodes at run time
//
// Everything else comes from the generated BuildInfo.h. The tools used to carry
// a hand-written copy of this block with a version of their own: 0.0.0.

#include <windows.h>
#include "BuildInfo.h"

// Numeric 1, not a named resource: the shell draws the LOWEST-numbered icon,
// and a string name sorts after every number. The extractor's window also asks
// for it by that number (LoadIconA(inst, MAKEINTRESOURCEA(1))).
#ifdef PRODUCT_ICON
1 ICON DISCARDABLE PRODUCT_ICON
#endif

// The extractor window's header badge, decoded at run time: a JPEG is not a
// BITMAP resource, so it travels as raw bytes and OleLoadPicture turns it into
// something drawable.
#ifdef PRODUCT_LOGO
MANGOSLOGO RCDATA DISCARDABLE PRODUCT_LOGO
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    PRODUCT_VERSION_RESOURCE
    PRODUCTVERSION PRODUCT_VERSION_RESOURCE
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      PRODUCT_COMPANY_STR
            VALUE "ProductName",      MANGOS_PACKAGENAME
            VALUE "ProductVersion",   MANGOS_VERSION_STR
            VALUE "FileVersion",      MANGOS_VERSION_STR
            VALUE "FileDescription",  PRODUCT_FILE_DESCRIPTION
            VALUE "InternalName",     PRODUCT_FILE_NAME
            VALUE "OriginalFilename", PRODUCT_FILE_NAME
            VALUE "LegalCopyright",   PRODUCT_COPYRIGHT_STR
            // The checkout this binary came out of. Version 0.22.0 says which
            // release it is; this says which build of it, which is what a bug
            // report needs.
            VALUE "Comments",         REVISION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
